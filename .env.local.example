# ============================================================
# BillBook.in — Environment Variables
# Copy this file to .env.local and fill in your real values
# NEVER commit .env.local to Git — it is in .gitignore
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
# Get from: supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Razorpay ──────────────────────────────────────────────────
# Get from: razorpay.com → Settings → API Keys
# Use rzp_test_... for development, rzp_live_... for production
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Google sign in
# Get from: Google Cloud Console -> APIs & Services -> Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── App URL ───────────────────────────────────────────────────
# Development:  http://localhost:3000
# Production:   https://billbook-ten.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
